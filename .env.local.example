# Copiar este archivo como .env.local y completar con tus datos reales.
# .env.local NO se sube a git (ya está en .gitignore).

# Resend (resend.com) - para enviar los correos
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Tu Nombre <tucorreo@tudominio.com>"

# MySQL en HostGator (phpMyAdmin)
DB_HOST=tudominio.com
DB_PORT=3306
DB_USER=usuario_hostgator
DB_PASSWORD=password_hostgator
DB_NAME=nombre_base_datos

# URL pública de la app (para armar el pixel y los links de tracking)
# En local: http://localhost:3000
# En producción: https://tu-dominio-o-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Acceso al panel (usuario y contraseña que pedirá el navegador)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contraseña

# A donde llega el aviso cuando alguien abre un correo por primera vez
NOTIFY_EMAIL=tucorreo@gmail.com

# Protege el endpoint del reporte semanal (Vercel Cron lo envia como Bearer)
CRON_SECRET=genera_un_valor_largo_y_aleatorio
